  "gates": [
    {"id": "structural-equivalence", "runtime": "cpu", "scope": "defaults and every frozen case of both parents"},
    {"id": "pixel-identity", "runtime": "gpu", "comparison": "byte-identical", "adapters": ["pinned SwiftShader (CI)", "NVIDIA GeForce GT 1030 Vulkan", "NVIDIA GeForce GT 1030 DX12"], "chrome": ["default", "one varied case per family"]},
    {"id": "budgets", "rule": "each parent within its material's frozen maxDescriptorPeakBytes and timing budgets; record changes against v1"},
    {"id": "controls", "rule": "conceptual control requests map onto the v2 public IDs and reproduce pixel-identity"},
    {"id": "isolation", "rule": "overriding one directional-grain instance leaves the other instance's expanded nodes unchanged"},
    {"id": "negative-corpus", "rule": "one focused fixture per contract rule"},
    {"id": "compatibility", "rule": "v1 fixtures, plan-hash snapshots, goldens, receipts and CLI v1 reports unchanged; v1 entry points and package v1 reject v2"}
  ],
  "presets": {
    "brick-paving": ["regular", "staggered", "varied"],
    "woven-fabric": ["plain", "varied", "combined-low"]
