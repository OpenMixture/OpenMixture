          "warpSeed", "weftSeed", "warpCount", "weftCount", "warpWidth", "weftWidth", "bevel", "crown", "underRatio",
          "warpDark", "warpColor", "weftDark", "weftColor", "backingColor", "roughnessMin", "yarnRoughness",
          "backingRoughness", "relief", "normalStrength"
        ]
      },
