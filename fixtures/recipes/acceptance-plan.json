        "seed": 3, "columns": 3, "rows": 3, "rowOffset": 3, "mortarX": 3, "mortarY": 3, "bevel": 3,
        "heightVariation": 1, "colorVariation": 1
      }
    },
    {
      "id": "weave-structure",
      "recipeVersion": 1,
      "nodes": ["weave-pattern@2", "weave-pattern@2", "weave-pattern@2"],
      "fixed": {"warpShare.mode": "warp-share", "coverage.mode": "coverage", "height.mode": "height"},
      "inputs": {},
      "outputs": ["warpShare", "coverage", "height"],
      "parameters": {
        "warpCount": 3, "weftCount": 3, "warpWidth": 3, "weftWidth": 3, "bevel": 3, "crown": 3, "underRatio": 3
      }
    },
    {
      "id": "directional-grain",
      "recipeVersion": 1,
      "nodes": ["fractal-noise@2", "transform-2d@1", "levels@1", "gradient-map@1"],
      "inputs": {},
      "outputs": ["grain", "color"],
      "parameters": {"seed": 1, "quarterTurns": 1, "darkColor": 1, "color": 1},
      "required": ["seed"]
    }
  ],
  "parents": [
    {
      "material": "brick-paving",
      "path": "fixtures/materials/brick-paving/material-recipes.mix",
      "replaces": "fixtures/materials/brick-paving/material.mix",
      "qualificationPlan": "fixtures/materials/brick-paving/qualification-plan.json",
      "instances": {"brick-structure": 1, "masked-layer-surface": 1},
      "exposed": {
        "v1": 24,
        "v2": ["seed", "columns", "rows", "rowOffset", "mortarX", "mortarY", "bevel", "heightVariation", "colorVariation", "normalStrength"]
      },
      "conceptualControls": {"variation": ["heightVariation", "colorVariation"]},
      "maxDescriptorPeakBytes": 469762048
    },
    {
      "material": "woven-fabric",
      "path": "fixtures/materials/woven-fabric/material-recipes.mix",
      "replaces": "fixtures/materials/woven-fabric/material.mix",
